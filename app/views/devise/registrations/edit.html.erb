<section class="account_container">
  <%= render "shared/account_setting" %>
  <div class="accountInformation">
    <div class="accountInformation_header">
      <h3 class="accountInformation_header_title">アカウント編集</h3>
    </div>
    
    
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email,"メールアドレス", class: "account_item_title" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "account_item_inputform" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <% resource.unconfirmed_email %></div>
      <% end %>

      <div class="field">
        <div class="account_item_title">
          <%= f.label :password,"変更後パスワード" %><br />
          <i class="item_title_detail">(変更する場合のみ)</i><br />
          <% if @minimum_password_length %>
            <em class="item_title_detail">(<%= @minimum_password_length %> 文字以上で入力)</em>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", class: "account_item_inputform" %>  
      </div>

      <div class="field">
        <div class="account_item_title">
          <%= f.label :password_confirmation,"確認用パスワード" %><br />
          <i class="item_title_detail">(変更する場合のみ)</i>
        </div>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "account_item_inputform" %>
      </div>

      <div class="field">
        <%= f.label :current_password,"現在のパスワード", class: "account_item_title" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "account_item_inputform" %>
      </div>

      <div class="actions">
        <%= f.submit "保存", class: "account_edit_savebtn" %>
      
    <% end %>

        <%= link_to "キャンセル", :back, class: "account_edit_cancelbtn" %>
      </div>
  </div>
</section>