<div class="roomSearchBar">
  <div class="roomSearchForm_container">
    <%= form_with url: rooms_path, method: :get, local: true, html: { class: "roomSearchForm" } do |f| %>
      <div>
        <%= f.text_field :address, value: params[:address], placeholder: "エリア名を入力", include_blank: "すべて", class: "searchBar_area" %>
      </div>
      <div>
        <%= f.text_field :keyword, value: params[:keyword], placeholder: "キーワードを入力", class: "searchBar_keyword" %>
      </div>

      <%= f.submit "検索", class: "searchBar_submit" %>
    <% end %>
  </div>
</div>



<div class="roomDetails_container">
  <div class="roomDetails_header"><%= link_to '⬅︎  戻る', :back, class: 'roomDetails_header_link' %></div>
    <div class="roomDetails">
      <p class="roomDetail_image">
        <% if @room.image.attached? %>
          <%= image_tag @room.image, size: "400x230" %>
        <% else %>
          <%= image_tag 'default-room_image.png', size: "400x230" %>
        <% end %>
      </p>

      <div class="roomDetailsBody">
        <div class="roomDetailsBody_nameANDprice">
          <p class="roomDetails_name"><%= @room.name %></p>
          <p class="roomDetails_price">¥<%= @room.fee %>〜</p>
        </div>

        <p class="roomDetails_address"><%= @room.address %></p>
        <p class="roomDetails_ntroduction"><%= @room.introduction %></p>
        

        <!-- 予約フォーム -->
        <%= form_with model: @reservation, url: room_reservation_confirm_path(@room), method: :post, local: true do |f| %>
          <div class="reservationForm_container">
            <div class="reservationForm_input-group">
              <%= f.label :checkin_date, "チェックイン" %>
              <%= f.date_field :checkin_date, class: "reservationForm_input" %>
            </div>
            <div class="reservationForm_input-group">
              <%= f.label :checkout_date, "チェックアウト" %>
              <%= f.date_field :checkout_date, class: "reservationForm_input" %>
            </div>
            <div class="reservationForm_input-group">
              <%= f.label :number_of_guests, "人数" %>
              <%= f.number_field :number_of_guests, class: "reservationForm_input" %>
            </div>
          </div>  

          <%= render "shared/error", obj: @reservation %>

          <div>
            <% if user_signed_in? %>
              <%= f.submit "予約する", class: "ReservationForm_button" %>
            <% else %>
              <%= link_to 'ログイン', new_user_session_path, class:'ReservationForm__button' %>
            <% end %>
          </div>
        <% end %> 
      </div>
    </div>
  </div> 
</div>