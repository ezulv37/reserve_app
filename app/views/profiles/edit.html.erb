<%= render "shared/account_setting" %>
<h1>プロフィール編集</h1>

<%= form_with model: @user, url: user_profile_path, method: :patch, local: true, html: { multipart: true } do |f| %>
  
  <div>
    <%= f.label :image, "アイコン画像" %><br>
    <% if @user.image.attached? %>
      <%= image_tag @user.image, size: "80x80" %>
    <% end %>
    <%= f.file_field :image %>
    <div>
      <% if @user.image.attached? %>
        <label>
          <%= check_box_tag :remove_image %>
          画像を削除する
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :introduction, "自己紹介" %><br>
    <%= f.text_area :introduction %>
  </div>

  <div>
    <%= f.submit "更新", class: "submit_btn" %>
  </div>
<% end %>
