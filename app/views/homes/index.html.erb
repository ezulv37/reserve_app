<h1>Homes#index</h1>
<p>Find me in app/views/homes/index.html.erb</p>

<thead>
  <tr>
    <th>id</th>
    <th>名前</th>
    <th>メールアドレス</th>
    <th>パスワード</th>
    <th>作成日</th>
  </tr>
</thead>

<% @users.each do |user| %>
  <tr>
    <td><%= user.id %></td>
    <td><%= user.name %></td>
    <td><%= user.email %></td>
    <td><%= user.password %></td>
    <td><%= user.created_at.to_s(:datetime_jp) %></td>
  </tr>
<% end %>